# ── deps & build artifacts ──
node_modules
dist
.vite
**/.vite-temp

# ── logs & OS ──
*.log
.DS_Store

# ── секреты: env-файлы ──
# Коммитим ТОЛЬКО шаблон .env.example. Всё остальное (.env, .env.dev, .env.prod,
# per-service services/*/.env) — локальные/прод-секреты, в git не попадают.
.env
.env.*
!.env.example
services/*/.env
apps/*/.env

# ── ключи и сертификаты ──
*.pem
*.key
# Dev-кэш JWT-пары auth-сервиса (см. services/auth/src/jwt.ts) — хранит RS256
# приватный+публичный между рестартами, чтобы 90-дневные десктоп-токены и
# refresh-cookies не инвалидировались. В prod не используется.
.dev-jwt-keys.json
