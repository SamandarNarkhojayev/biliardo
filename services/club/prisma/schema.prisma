// Club-сервис: владеет схемой `club`.
// Хранит снимки состояния клуба (один на клуб, перезаписывается при каждом SYNC)
// и историю завершённых сессий (idempotent по externalId).
// userId/clubId — opaque-строки, FK на чужие схемы не используем.

generator client {
  provider = "prisma-client-js"
  output   = "../src/_prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["club"]
}

/// Последний снимок состояния клуба. Один на клуб, перезаписывается при каждом SYNC.
model ClubSyncSnapshot {
  id        String   @id @default(cuid())
  clubId    String   @unique           // user.id из auth-схемы (opaque)
  /// JSON: TableSnapshot[] (см. shared types)
  tables    Json
  /// JSON: { table, bar, total, sessionsCount }
  revenue   Json
  syncedAt  DateTime @default(now())

  @@schema("club")
}

/// История завершённых сессий, присланных desktop-приложением.
/// externalId уникален в пределах clubId — повторный sync не дублирует.
model ClubSessionRecord {
  id          String   @id @default(cuid())
  clubId      String
  externalId  String
  tableId     Int
  tableName   String
  mode        String
  /// Название тарифа (если запущен по тарифу) — для отображения в истории.
  tariffName  String?
  startTime   DateTime
  endTime     DateTime
  /// Минуты
  duration    Int
  /// Тенге
  tableCost   Int
  barCost     Int
  totalCost   Int
  /// JSON: BarOrderItem[] — позиции бар-заказов, привязанные к сессии.
  /// Опционально, поэтому Json? (старые сессии без детализации остаются валидными).
  barOrders   Json?
  /// "YYYY-MM-DD" — для быстрой группировки в отчётах
  date        String
  /// Опционально: id смены, в которой была завершена сессия.
  shiftId     String?
  createdAt   DateTime @default(now())

  @@unique([clubId, externalId])
  @@index([clubId, date])
  @@index([clubId, startTime])
  @@index([clubId, shiftId])
  @@schema("club")
}

/// История смен, присланных desktop-приложением (когда оператор открывает/закрывает смену).
/// externalId — id смены из desktop'а; идемпотентность по {clubId, externalId}.
model ClubShiftRecord {
  id          String    @id @default(cuid())
  clubId      String
  externalId  String
  /// Локальный userId оператора в desktop'е (НЕ auth.User — это внутренняя сущность desktop'а).
  operatorId  String
  operatorName String
  startTime   DateTime
  endTime     DateTime?
  /// true пока смена активна (endTime = null).
  isActive    Boolean   @default(true)
  /// Сумма выручки по смене (table + bar), посчитана на десктопе.
  totalRevenue Int      @default(0)
  tableRevenue Int      @default(0)
  barRevenue   Int      @default(0)
  sessionsCount Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clubId, externalId])
  @@index([clubId, startTime])
  @@schema("club")
}
