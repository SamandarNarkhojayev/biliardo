# ════════════════════════════════════════════════════════════════════
#  biliardo.kz — пример переменных окружения (TEMPLATE)
# ════════════════════════════════════════════════════════════════════
#
# Этот файл КОММИТИТСЯ в git. Здесь только ПЛЕЙСХОЛДЕРЫ — никаких реальных секретов!
#
# Использование:
#   • dev   →  cp .env.example .env.dev    (локальные значения; docker compose читает его)
#   • prod  →  cp .env.example .env.prod   (на сервере, заполнить боевыми секретами)
#
# Оба файла .env.dev / .env.prod — в .gitignore.
#
# Подробности по каждой секции:
#   • S3 (ps.kz)   → см. S3.md
#   • Kaspi Pay    → см. kaspi.md
#   • JWT keypair  → openssl genpkey + openssl rsa -pubout (см. инструкции ниже)
# ════════════════════════════════════════════════════════════════════


# ────────────────── 1. БАЗА ДАННЫХ (Postgres) ──────────────────
POSTGRES_DB=billiard
POSTGRES_USER=billiard
# (secret) сгенерировать: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-postgres-password


# ────────────────── 2. ВНУТРЕННИЕ СЕКРЕТЫ ──────────────────
# (secret) Общий секрет для service-to-service RPC.
# Сгенерировать: openssl rand -hex 32
# В prod ОБЯЗАТЕЛЬНО заменить — иначе сервисы откажутся стартовать.
INTERNAL_SECRET=


# ────────────────── 3. JWT (RSA 2048, PKCS8/SPKI PEM) ──────────────────
# (secret, prod only) RSA-пара. Сгенерировать:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Содержимое .pem-файлов вставить в кавычки (многострочно).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30


# ────────────────── 4. ОБЩЕДОСТУПНЫЕ URL ──────────────────
# dev :  PUBLIC_APP_URL=http://localhost:5173   VITE_API_URL=http://localhost:3000/api   VITE_CLUB_WS_URL=ws://localhost:3004
# prod:  PUBLIC_APP_URL=https://biliardo.kz     VITE_API_URL=/api                        VITE_CLUB_WS_URL=wss://biliardo.kz/club-ws
PUBLIC_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
VITE_CLUB_WS_URL=ws://localhost:3004
# Показывать кнопку «Оплатить через Kaspi» в модалке тарифа.
# false — в модалке только WhatsApp. true — когда настроен live или bridge.
VITE_KASPI_ENABLED=false
# Режим оплаты на чекауте: live (официальный Kaspi QR) или bridge (перевод на Kaspi Gold).
VITE_KASPI_MODE=bridge
# Реквизиты для bridge-перевода (показываются клиенту на чекауте):
VITE_KASPI_GOLD_NUMBER=+7XXXXXXXXXX
VITE_KASPI_GOLD_NAME=Имя Ф.
# (опц.) ссылка на картинку твоего статичного Kaspi QR «Получить перевод»:
VITE_KASPI_GOLD_QR_URL=


# ────────────────── 5. COOKIE / CORS ──────────────────
# В prod указать корневой домен (без http/https). В dev можно опустить.
COOKIE_DOMAIN=


# ────────────────── 6. RATE LIMIT (gateway) ──────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute


# ────────────────── 7. KASPI QR MERCHANT API ──────────────────
# stub — фейковый flow для dev (всегда успех, финализация кнопкой)
# live — реальный Kaspi QR Merchant API (poll-based, см. kaspi.md)
KASPI_MODE=stub
# Базовый домен: test → https://mtokentest.kaspi.kz, prod → https://mtoken.kaspi.kz
KASPI_BASE_DOMAIN=
# Схема: r1 (EASY) / r2 (MEDIUM) / r3 (STRONG, mTLS). По умолчанию r3.
KASPI_SCHEME=r3
# Креды устройства/мерчанта (выдаёт Kaspi после онбординга):
KASPI_API_KEY=
KASPI_DEVICE_TOKEN=
KASPI_ORGANIZATION_BIN=
# mTLS-сертификаты (обязательны для STRONG/r3):
KASPI_CA_PATH=
KASPI_CERT_PATH=
KASPI_KEY_PATH=
KASPI_KEY_PASS=
# Только для sandbox — отключает проверку SSL:
KASPI_TEST_MODE=false
# Опционально: секрет для HMAC-подписи callback'а (если включён в договоре):
KASPI_WEBHOOK_SECRET=
# ── BRIDGE-режим (надстройка над своим Kaspi Gold, без онбординга) ──
# Секрет эндпоинта приёма уведомлений с телефона (заголовок x-bridge-secret):
KASPI_BRIDGE_SECRET=
# Номер Kaspi Gold и имя получателя (для инструкции клиенту):
KASPI_GOLD_NUMBER=
KASPI_GOLD_NAME=
# Разброс уникальных «хвостов» суммы в тенге (для матчинга параллельных платежей):
KASPI_BRIDGE_AMOUNT_SPREAD=100


# ────────────────── 8. S3 (ps.kz Object Storage) ──────────────────
# Создать два бакета (см. S3.md):
#   • biliardo-media   — public-read
#   • biliardo-backups — private
S3_ENDPOINT=https://object.pscloud.io
S3_REGION=kz-ala-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_MEDIA=biliardo-media
S3_BUCKET_BACKUPS=biliardo-backups
# Опционально: кастомный CDN-домен поверх бакета.
S3_PUBLIC_URL=

BACKUP_RETENTION_DAYS=30


# ────────────────── 9. TELEGRAM BOT ──────────────────
# Получить токен у @BotFather через /newbot, имя бота — латиницей с суффиксом _bot.
# TELEGRAM_BOT_USERNAME — без префикса @.
# Если оставить TELEGRAM_BOT_TOKEN пустым — bot-сервис не запустится; tournament и фронт
# продолжат работать без уведомлений.
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=your_bot_username


# ────────────────── 10. ПРОЧЕЕ ──────────────────
REGISTER_CONCURRENCY=8
LOG_LEVEL=info
# Лимит времени на SQL-запрос из админ-консоли (мс).
SQL_TIMEOUT_MS=15000


# ────────────────── 11. CI/CD · DEPLOY ──────────────────
# docker-compose.prod.yml тянет образы как ${REGISTRY}/<service>:${IMAGE_TAG}.
# В CI (GitHub Actions) эти переменные выставляются автоматически:
#   REGISTRY  = ghcr.io/<owner>/<repo>   (нижний регистр)
#   IMAGE_TAG = git sha коммита
# Для ручного деплоя на сервере задайте их перед ./scripts/deploy.sh, например:
#   REGISTRY=ghcr.io/owner/repo IMAGE_TAG=latest ./scripts/deploy.sh
REGISTRY=ghcr.io/CHANGE_ME
IMAGE_TAG=latest
